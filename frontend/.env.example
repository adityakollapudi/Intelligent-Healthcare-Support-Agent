# Copy to .env.local. Everything prefixed VITE_ is shipped to the browser: never put secrets here.
# Base URL of the IHSA backend API (Phase 2 default when running `uvicorn app.main:app`).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Client-side request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
