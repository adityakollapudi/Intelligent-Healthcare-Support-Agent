# Docker Compose settings (copy to .env; never commit .env). Placeholders only.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Demo accounts' password (only used by `docker compose --profile demo run --rm seed`).
SEED_USER_PASSWORD=replace-with-a-demo-password
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8000/api/v1
# extractive (no LLM, default) or anthropic (requires an approved key)
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
