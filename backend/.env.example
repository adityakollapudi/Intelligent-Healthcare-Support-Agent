# Copy to .env and adjust. Never commit .env. Values below are safe placeholders only.

APP_NAME=intelligent-healthcare-support-agent
# development | test | production  (production enables extra safety checks and disables /docs)
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Driver must be postgresql+psycopg. This example points at the private development cluster
# created by scripts/local_postgres.ps1 (localhost-only, trust auth, synthetic data only).
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/ihsa_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
# When true the API refuses to start if the database is unreachable.
DB_REQUIRED_AT_STARTUP=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TOKEN_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Comma-separated list of allowed browser origins (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Read only by scripts/seed_demo_data.py: password given to every synthetic demo account
# (minimum 12 characters). Choose your own; it is hashed with argon2id before storage.
SEED_USER_PASSWORD=

# --- AI / RAG (Phase 4) -------------------------------------------------------------------------
# extractive = no LLM: answers quote the retrieved source sentences (clearly labeled in every answer).
# anthropic  = Claude via the official SDK; requires ANTHROPIC_API_KEY. The app never switches
#              between the two on its own.
LLM_PROVIDER=extractive
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1500
ANTHROPIC_API_KEY=

# Local embedding model (downloaded once into EMBEDDING_CACHE_DIR, ~130 MB, runs on CPU).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=.local/models

RAG_KNOWLEDGE_DIR=data/knowledge
RAG_CHUNK_WORDS=160
RAG_CHUNK_OVERLAP_WORDS=30
RAG_TOP_K=5
# Provisional, calibrated on data/evaluation/rag_eval_v1.jsonl (see docs/phase-4/rag-evaluation-report.md)
RAG_MIN_RELEVANCE=0.70
RAG_CONTEXT_CHAR_BUDGET=6000
CHAT_HISTORY_MESSAGES=6
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_SESSION_RETENTION_DAYS=30
TOOL_MAX_CALLS_PER_MESSAGE=3

# --- Documents and readiness (Phase 6) ----------------------------------------------------------
# Private upload volume; must not be inside a publicly served directory. Synthetic documents only.
DOCUMENT_STORAGE_DIR=.local/uploads
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20
MAX_IMAGE_MEGAPIXELS=25
JOB_TIMEOUT_SECONDS=120
MAX_CONCURRENT_DOCUMENT_JOBS=1
DOCUMENT_UPLOADS_PER_HOUR=20
DOCUMENT_ANALYSES_PER_HOUR=30
# Provisional default (no organizational policy provided).
DOCUMENT_RETENTION_DAYS=30
# OCR for scanned pages and images: "tesseract" (install Tesseract, then set OCR_TESSERACT_PATH to the
# executable, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe) or "disabled". When the engine is
# missing, scanned pages are reported as unreadable; nothing is guessed.
OCR_ENGINE=tesseract
OCR_TESSERACT_PATH=tesseract
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_MIN_TEXT_CHARS_PER_PAGE=50
OCR_MIN_WORD_CONFIDENCE=60
EXTRACTION_LOW_CONFIDENCE=0.70

# Used only by the test suite. The database name must end in "_test"; tests drop and
# recreate its schema.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/ihsa_test
